# ── Payload CMS ───────────────────────────────────────────────────────
# Any Postgres 15+ database. Supabase works; use the session pooler URL.
# Payload owns the `payload` schema, so legacy public tables stay untouched.
DATABASE_URL=postgresql://user:password@host:5432/postgres
# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Dev only: let Payload push schema changes. Set false in production and run
# `npm run db:migrate` as part of the deploy.
PAYLOAD_PUSH=true

# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Local content sync ────────────────────────────────────────────────
# Shared secret for POST /dev/seed. The route is disabled in production.
DEV_SEED_TOKEN=
